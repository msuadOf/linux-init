# macOS 专属环境。仅在系统能够发现 JDK 时设置 JAVA_HOME。
if [ -z "${JAVA_HOME:-}" ] && [ -x /usr/libexec/java_home ]; then
    if __linux_init_java_home=$(/usr/libexec/java_home 2>/dev/null); then
        export JAVA_HOME=$__linux_init_java_home
        __linux_init_path_prepend "$JAVA_HOME/bin"
    fi
    unset __linux_init_java_home
fi
