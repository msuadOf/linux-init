# Linux 专属的开发环境。

if [ -z "${JAVA_HOME:-}" ]; then
    for __linux_init_java_home in \
        /usr/lib/jvm/java-17-openjdk-amd64 \
        /usr/lib/jvm/java-17-openjdk \
        /usr/lib/jvm/default-java; do
        if [ -d "$__linux_init_java_home" ]; then
            JAVA_HOME=$__linux_init_java_home
            export JAVA_HOME
            break
        fi
    done
    unset __linux_init_java_home
fi

if [ -n "${JAVA_HOME:-}" ] && [ -d "$JAVA_HOME/bin" ]; then
    __linux_init_path_prepend "$JAVA_HOME/bin"
fi

# 仅在 nix-portable 确实存在时覆盖 nix；原生 Nix 保持不变。
if command -v nix-portable >/dev/null 2>&1; then
    export NP_LOCATION="${NP_LOCATION:-$HOME/.nix}"
    alias nix='nix-portable nix'
    alias nix-run='nix-portable nix run'
    alias nix-build='nix-portable nix build'
    alias home-manager='nix-portable home-manager'
fi
