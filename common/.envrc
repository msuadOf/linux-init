# Linux 和 macOS 共享的环境。平台专属路径放在 platform/<os>/.envrc。

__linux_init_path_prepend() {
    [ -d "$1" ] || return 0
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="$1${PATH:+:$PATH}" ;;
    esac
    export PATH
}

__linux_init_path_append() {
    [ -d "$1" ] || return 0
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="${PATH:+$PATH:}$1" ;;
    esac
    export PATH
}

__linux_init_path_prepend "$HOME/.local/bin"
