# 公共代理命令。
# 开启代理
function proxy_on(){
    local proxy_ip="127.0.0.1"
    local proxy_port="7890"
    
    # WSL的特殊默认值
    if [ -r /proc/sys/kernel/osrelease ] && grep -qi "microsoft" /proc/sys/kernel/osrelease; then
        proxy_ip=$(ip route | awk '/default/ { print $3; exit }')
        proxy_port="7897"
    fi

    # 根据参数数量处理
    case $# in
        0)
            # 无参数，使用默认值
            ;;
        1)
            # 一个参数
            if [[ "$1" =~ ^[0-9]+$ ]]; then
                # 纯数字，当作PORT
                proxy_port="$1"
            elif [[ "$1" =~ : ]]; then
                # 包含冒号，拆分IP和PORT
                IFS=':' read -r proxy_ip proxy_port <<< "$1"
            else
                # 其他情况，当作IP
                proxy_ip="$1"
            fi
            ;;
        *)
            # 两个或多个参数，前两个作为IP和PORT
            proxy_ip="$1"
            proxy_port="$2"
            ;;
    esac
    
    # 设置代理环境变量
    export all_proxy="socks5://${proxy_ip}:${proxy_port}"
    export http_proxy="http://${proxy_ip}:${proxy_port}"
    export https_proxy="http://${proxy_ip}:${proxy_port}"
    export ALL_PROXY="socks5://${proxy_ip}:${proxy_port}"
    export HTTP_PROXY="http://${proxy_ip}:${proxy_port}"
    export HTTPS_PROXY="http://${proxy_ip}:${proxy_port}"
	export NO_PROXY="192.168.0.0/16,127.0.0.1,localhost"                                                                                                    
    export no_proxy="192.168.0.0/16,127.0.0.1,localhost"    
    export LINUX_INIT_PROXY_ADDRESS="${proxy_ip}:${proxy_port}"
}

# 关闭代理
function proxy_off(){
    unset all_proxy
    unset http_proxy
    unset https_proxy
	unset ALL_PROXY
    unset HTTP_PROXY
    unset HTTPS_PROXY
    unset NO_PROXY
    unset no_proxy
    unset LINUX_INIT_PROXY_ADDRESS
}

function proxy_test(){
    case $# in
        0)
            echo "all_proxy   = $all_proxy  "
            echo "http_proxy  = $http_proxy "
            echo "https_proxy = $https_proxy"
	        echo "ALL_PROXY   = $ALL_PROXY  "
            echo "HTTP_PROXY  = $HTTP_PROXY "
            echo "HTTPS_PROXY = $HTTPS_PROXY"
            echo "==================="
            echo "[curl -I https://www.google.com]:"
            curl -I https://www.google.com
            ;;
        *)
            proxy_on "$@"
            proxy_test
            ;;
    esac
}

function on(){
    proxy_on "$@"
    printf 'proxy_on: 已开启代理 %s\n' "$LINUX_INIT_PROXY_ADDRESS"
}

function off(){
    proxy_off
    printf 'proxy_off: 已关闭代理\n'
}

alias pt=proxy_test
